# 环境变量模板：复制成 .env 后修改（.env 已在 .gitignore 里，不会被提交）
# ---------------------------------------------------------------

# 服务端口（Docker/反代都不用改）
PORT=3000

# JWT 签名密钥 —— 必改！生成方法：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=请替换成 64 位随机字符串
JWT_EXPIRES=7d

# 数据库
# 裸机部署用 127.0.0.1；docker compose 会被覆盖成 db，无需修改
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=comic
DB_PASSWORD=请替换成数据库密码
DB_NAME=yuyin_comic

# 仅 docker compose 使用：root 密码（MySQL 容器初始化用）
DB_ROOT_PASSWORD=请替换成 root 密码

# 允许跨域的来源，多个用英文逗号分隔；同站部署留空即可
# 例：CORS_ORIGIN=https://comic.example.com
CORS_ORIGIN=
